                "type": "string",
              },
              "feedbackId": {
                "maxLength": 36,
                "minLength": 36,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string",
              },
              "receivedAt": {
                "maxLength": 24,
                "minLength": 24,
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
                "type": "string",
              },
              "schemaVersion": {
                "const": 1,
                "type": "integer",
              },
            },
            "required": [
              "schemaVersion",
              "eventId",
              "feedbackId",
              "receivedAt",
              "duplicate",
            ],
            "type": "object",
          },
        },
        "required": [
          "code",
          "receipt",
        ],
        "type": "object",
      },
      {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "invalid_input",
              "cancelled",
              "timeout",
              "aborted",
              "collector_rejected",
              "internal_error",
              "outcome_unknown",
            ],
            "type": "string",
          },
        },
