{
  "name": "filika",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev": "bun run dev:webmcp",
    "dev:webmcp": "bun run apps/web/server.ts",
    "dev:collector": "bun run packages/collector/src/server.ts",
    "dev:sdk-smoke": "bun run --filter @filika/sdk build && bun tests/e2e/src/sdk-smoke-server.ts",
    "db:migrate": "bun run --filter @filika/collector db:migrate",
    "db:cleanup": "bun run --filter @filika/collector db:cleanup",
    "db:reset": "bun run --filter @filika/collector db:reset",
    "db:seed": "bun run --filter @filika/collector db:seed",
    "install:frozen": "bun install --frozen-lockfile",
    "lint": "biome check . && bun run typecheck",
    "test:browser": "playwright test --config tests/e2e/playwright.config.ts",
    "test:browser:prepare": "bun run tests/e2e/database.ts reset",
    "test:unit": "bun test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "ajv": "8.17.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.2"
  },
  "description": "Filika user-reviewed browser feedback workflow",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Complaintr/filika.git"
  },
  "bugs": {
    "url": "https://github.com/Complaintr/filika/issues"
  }
}
