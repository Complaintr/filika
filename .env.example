DATABASE_URL=postgres://filika:filika@localhost:55432/filika
BETTER_AUTH_URL=http://localhost:4173
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional repository integration. These belong to a GitHub App, not the login OAuth app.
# Register /api/v1/github/callback and /api/v1/github/webhook on BETTER_AUTH_URL.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM private key; use a quoted value with literal \n between lines.
GITHUB_APP_PRIVATE_KEY=
# Generate a separate 32-byte encryption key as 64 hex characters.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Use a separate random secret of at least 32 characters.
GITHUB_APP_WEBHOOK_SECRET=

# Resend API key and a sender on your verified Resend domain. Server-only.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
